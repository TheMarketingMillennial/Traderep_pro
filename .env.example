# ─────────────────────────────────────────────────────────────────────────────
# TradeRep Pro — Build-Time Environment Variables
#
# Copy this file to .env and fill in real values.
# .env is in .gitignore — NEVER commit the filled-in version.
#
# These values are injected at build time via --dart-define flags.
# See scripts/build_with_secrets.sh for how to use them.
# ─────────────────────────────────────────────────────────────────────────────

# ── Firebase ─────────────────────────────────────────────────────────────────
# Get these from Firebase Console → Project Settings → Your apps
# OR from your google-services.json (keep that file local, never commit it)

FIREBASE_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_MESSAGING_SENDER_ID=000000000000
FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
FIREBASE_DATABASE_URL=https://your-project-id-default-rtdb.firebaseio.com

# App IDs — one per platform (find in Firebase Console → Project Settings)
FIREBASE_APP_ID_WEB=1:000000000000:web:xxxxxxxxxxxxxxxx
FIREBASE_APP_ID_ANDROID=1:000000000000:android:xxxxxxxxxxxxxxxx
FIREBASE_APP_ID_IOS=1:000000000000:ios:xxxxxxxxxxxxxxxx

# ── SMS Proxy Server ──────────────────────────────────────────────────────────
# Local dev:   http://localhost:5061
# Production:  https://your-app.up.railway.app  (set after Railway deploy)
SMS_SERVER_URL=http://localhost:5061

# ── Future integrations (add dart-define entries as you add services) ─────────
# STRIPE_PUBLISHABLE_KEY=pk_live_XXXXXXXXXXXXXXXXXXXXXXXX
# GOOGLE_MAPS_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXX
