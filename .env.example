# ─────────────────────────────────────────────────────────────────────────────
# TradeRep Pro — Build-Time Environment Variables
#
# Copy this file to .env and fill in real values.
# .env is in .gitignore — NEVER commit the filled-in version.
#
# These values are injected at Flutter build time via --dart-define flags.
# See scripts/build_with_secrets.sh for the build runner.
#
# Production app: https://app.tradereppro.com
# Railway backend: https://traderep-server-production.up.railway.app
# ─────────────────────────────────────────────────────────────────────────────

# ── Firebase (Web platform) ───────────────────────────────────────────────────
# Get from: Firebase Console → Project Settings → Your apps → Web app
# Android reads from google-services.json at runtime (no dart-defines needed).

FIREBASE_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
FIREBASE_PROJECT_ID=traderep-pro
FIREBASE_MESSAGING_SENDER_ID=518784222528
FIREBASE_AUTH_DOMAIN=traderep-pro.firebaseapp.com
FIREBASE_STORAGE_BUCKET=traderep-pro.firebasestorage.app
FIREBASE_DATABASE_URL=https://traderep-pro-default-rtdb.firebaseio.com

# App IDs — one per platform (Firebase Console → Project Settings → Your apps)
FIREBASE_APP_ID_WEB=1:518784222528:web:xxxxxxxxxxxxxxxx
FIREBASE_APP_ID_ANDROID=1:518784222528:android:xxxxxxxxxxxxxxxx
FIREBASE_APP_ID_IOS=1:518784222528:ios:xxxxxxxxxxxxxxxx

# ── Railway Backend ───────────────────────────────────────────────────────────
# All four URLs point to the same production Railway server.
# Override individually only if running a split-service setup.
# Default (in app_config.dart): https://traderep-server-production.up.railway.app

AI_SERVER_URL=https://traderep-server-production.up.railway.app
SMS_SERVER_URL=https://traderep-server-production.up.railway.app
GBP_SERVER_URL=https://traderep-server-production.up.railway.app
STRIPE_SERVER_URL=https://traderep-server-production.up.railway.app

# ── Stripe (client-side publishable key only) ─────────────────────────────────
# Secret key stays in Railway env vars — never in the app.
STRIPE_PUBLISHABLE_KEY=pk_live_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
